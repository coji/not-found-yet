<% @title = "変異の記録" %>

<section class="hero small">
  <p class="eyebrow">固定された観測窓</p>
  <h1 class="jp">変異の記録</h1>
  <p class="voice">事実と、それを私がどう受け取ったか。どちらも残す。まちがえたものも。</p>
</section>

<% if @selected %>
  <% e = @selected %>
  <section class="panel entry">
    <p class="entry-head">
      第 <%= h(e['generation_after']) %> 世代 · 身体 <%= h(e['body_short_id']) %> · PID <%= h(e['pid']) %>
      <span class="status <%= h(e['status']) %>"><%= h(label(e['status'])) %></span>
    </p>

    <h3>観測</h3>
    <p><%= h(e['observation_summary'] || '—') %></p>

    <h3>解釈</h3>
    <p><%= h(e['interpretation'] || '—') %></p>

    <h3>いちばん強い欲求</h3>
    <p><%= h(label(e['dominant_desire'])) %><%
      if e['psyche']
        top = e['psyche'].sort_by { |_, v| -v.to_f }.first(3)
                         .map { |k, v| "#{label(k)} #{format('%.2f', v)}" }.join(" · ")
    %> <span class="muted">— <%= h(top) %></span><% end %></p>

    <% if e['candidates'] %>
      <h3>候補</h3>
      <ul>
        <% e['candidates'].each_with_index do |c, i| %>
          <li<%= i == e['choice_index'] ? ' class="chosen"' : '' %>>
            <%= h(c.dig('intent', 'type')) %>
            <span class="muted">見込み <%= h(c['expected_gain']) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <h3>変異</h3>
    <p><%= h(e['intent_description'] || e.dig('intent', 'type') || '—') %></p>
    <% if e['reason'] %><p class="reason"><%= h(e['reason']) %></p><% end %>

    <% if @exhibit %>
      <h3>コード展示 <span class="muted">表示専用 · 再生されることはない</span></h3>
      <pre><code><%= h(@exhibit) %></code></pre>
    <% end %>

    <h3>費用</h3>
    <p>複雑性 <%= h(e.dig('cost', 'complexity')) %> · 注意力 $<%= h(format('%.4f', e.dig('cost', 'attention_usd').to_f)) %></p>

    <% if e['sacrifice'] && !e['sacrifice'].empty? %>
      <h3>引き換えに失ったもの</h3>
      <p><%= h(e['sacrifice']) %></p>
    <% end %>

    <% if e['fitness'] %>
      <h3>適応度</h3>
      <p><%= h(e['fitness']) %>
        <span class="muted"><%= h(e['fitness_detail'].to_a.map { |k, v| "#{k} #{v}" }.join(' · ')) %></span></p>
    <% end %>

    <h3>結末</h3>
    <p><%= h(label(e['status'])) %>
      · smoke <%= h(e.dig('smoke', 'passed') ? '通過' : (e['smoke'] ? '失敗' : '未実行')) %>
      · <%= h(e['pid_stable'] ? '同じ PID のまま' : 'PID が変わった') %></p>

    <p><a href="/mutations">← すべての世代</a></p>
  </section>
<% else %>
  <section class="panel">
    <% if @entries.empty? %>
      <p class="muted">まだ何も決めていない。</p>
    <% else %>
      <table>
        <thead>
          <tr><th>連番</th><th>世代</th><th>変異</th><th>結末</th><th>欲求</th><th>費用</th><th>時刻</th></tr>
        </thead>
        <tbody>
          <% @entries.each do |e| %>
            <tr>
              <td data-label="連番"><a href="/mutations?seq=<%= h(e['seq']) %>"><%= h(e['seq']) %></a></td>
              <td data-label="世代"><%= h(e['generation_after']) %></td>
              <td data-label="変異"><%= h(e['intent_description'] || e.dig('intent', 'type')) %></td>
              <td data-label="結末"><span class="status <%= h(e['status']) %>"><%= h(label(e['status'])) %></span></td>
              <td data-label="欲求" class="muted"><%= h(label(e['dominant_desire'])) %></td>
              <td data-label="費用" class="muted">$<%= h(format('%.4f', e.dig('cost', 'attention_usd').to_f)) %></td>
              <td data-label="時刻" class="muted"><%= h(e['at']) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <section class="panel">
    <h2>傷跡</h2>
    <% scars = EvolutionJournal.scars(8) %>
    <% if scars.empty? %>
      <p class="muted">まだ傷はない。</p>
    <% else %>
      <ul>
        <% scars.each do |s| %>
          <li><span class="status <%= h(s['status']) %>"><%= h(label(s['status'])) %></span>
            <%= h(s['intent'] || '—') %>
            <span class="muted"><%= h(s['reason']) %></span></li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>

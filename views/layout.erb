<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(@title || "I don't know what I am yet") %></title>
<link rel="stylesheet" href="/app.css">
<%# 企画書と同じ lime の点。/favicon.ico への問い合わせも一件減る。 %>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='7' fill='%23c8ff6b'/></svg>">
</head>
<body>
<header class="masthead">
  <a class="wordmark" href="/">I DON'T KNOW WHAT <span class="ghost">I AM</span> YET</a>
  <nav>
    <a href="/">self</a>
    <a href="/status">status</a>
    <a href="/mutations">mutations</a>
  </nav>
</header>

<main>
<%= yield %>
</main>

<div class="footline">
  <span>body <%= h(Body.short_id) %> · pid <%= h(Body.pid) %> · generation <%= h(Body.generation) %></span>
  <span class="mode <%= h(Body.mode) %>"><%= h(Body.mode) %></span>
</div>
</body>
</html>
